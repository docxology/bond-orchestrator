# BOND-ORCHESTRATOR Configuration Template
# Copy this file to config.yaml and customize for your project.
# Loaded by `yaml.safe_load` via src/bond_orchestrator/manuscript_variables.py
# (mission parameters) and infrastructure/rendering (manuscript metadata).

identity:
  name: "BOND-ORCHESTRATOR"
  codename: "DAG 00"   # package codename; mission codenames live per-mission
  layer: "Layer 3 — multi-package mission DAG runner"

paper:
  title: "Your Orchestrator Title"
  subtitle: "Optional Subtitle"
  version: "1.0"
  date: ""  # Auto-generated by infrastructure/validation/output/validator.py if empty

# Consumed by: `infrastructure.publishing.extract_publication_metadata`
authors:
  - name: "Your Name"
    orcid: "0000-0000-0000-0000"  # Get from https://orcid.org/
    email: "your.email@university.edu"
    affiliation: "Your University"
    corresponding: true

# Optional: Multiple authors
#  - name: "Co-Author Name"
#    orcid: "0000-0000-0000-0000"
#    email: "coauthor@university.edu"
#    affiliation: "Co-Author University"
#    corresponding: false

# Release workflow (Zenodo + GitHub): see docs/guides/publishing-guide.md and
# docs/guides/zenodo-doi-strategy.md for the split concept/version DOI layout.
publication:
  doi: ""  # Concept DOI — stable citation
  version_doi: ""  # Latest Zenodo version DOI
  version_record: ""  # https://zenodo.org/records/{id}
  github_repository: ""  # e.g. docxology/bond-orchestrator
  transmission_bookends:
    enabled: false
    max_prior_releases: 5
    show_steganography: true
  deposit_filename:
    enabled: true
    topic: ""
  journal: ""
  volume: ""
  pages: ""
  year: ""

keywords:
  - "mission orchestration"
  - "DAG scheduling"
  - "checkpoint/resume"
  - "provenance"
  - "deterministic execution"

metadata:
  license: "MIT"
  language: "en"

steganography:
  enabled: true
  overlays_enabled: true
  barcodes_enabled: true
  metadata_enabled: true
  hashing_enabled: true
  encryption_enabled: false
  overlay_mode: "text"
  overlay_text: "CONFIDENTIAL"

render:
  formats:
    pdf: true
    html: true
    slides: true
    docx: true
    epub: true

testing:
  max_test_failures: 0
  max_infra_test_failures: 0
  max_project_test_failures: 0

# Mission parameters — read by scripts/run_mission.py consumers and
# scripts/generate_manuscript_variables.py.
mission:
  name: "OPERATION_OMNIBUS"
  packages: [goldfinger, goldeneye, no_time_to_die]
  phases: [brief, recon, plan, execute, debrief]
